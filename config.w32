// vim: ft=javascript

ARG_WITH("dlib", "dlib support", "no");

if (PHP_DLIB != "no") {
    
    var dlib_root = PHP_DLIB;
    var dlib_inc  = dlib_root + "\\include";
    var dlib_lib  = dlib_root + "\\lib";

    if (!CHECK_HEADER_ADD_INCLUDE("dlib/dnn.h", "CFLAGS", dlib_inc)) {
        ERROR("dlib/dnn.h not found in " + dlib_inc);
    }

    var files = glob(dlib_lib + "\\*.lib");

    var found_lib = files.length > 0 ? files[0] : "";

    if (found_lib !== "") {

        CHECK_LIB("dlib.lib", "php_dlib", PHP_DLIB);

        EXTENSION("php_dlib", "php_dlib.cpp", true,
            "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1 /EHsc"
        );

        ADD_SOURCES(configure_module_dirname + "/src", "\
            chinese_whispers.cpp \
            face_detection.cpp \
            face_landmark_detection.cpp \
            face_recognition.cpp \
            cnn_face_detection.cpp \
            vector.cpp",
            "php_dlib"
        );
 

        AC_DEFINE("HAVE_DLIB", 1, "dlib enabled");

    } else {
        WARNING("dlib.lib not found");
        PHP_DLIB = "no";
    }
}
