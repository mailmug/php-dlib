// vim: ft=javascript

ARG_WITH("dlib", "dlib support", "no");

if (PHP_DLIB != "no") {

    var dlib_root = PHP_DLIB;
    var dlib_inc  = dlib_root + "\\include";
    var dlib_lib  = dlib_root + "\\lib";

    if (!CHECK_HEADER_ADD_INCLUDE("dlib/dnn.h", "CFLAGS", dlib_inc)) {
        ERROR("dlib/dnn.h not found in " + dlib_inc);
    }

    if (CHECK_LIB("dlib.lib", "dlib", dlib_lib)) {

        EXTENSION("php_dlib",
            "php_dlib.cc " +
            "src/chinese_whispers.cc " +
            "src/face_detection.cc " +
            "src/face_landmark_detection.cc " +
            "src/face_recognition.cc " +
            "src/cnn_face_detection.cc " +
            "src/vector.cc"
        );

        AC_DEFINE("HAVE_DLIB", 1, "dlib enabled");

        ADD_FLAG("CFLAGS", "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");
        ADD_FLAG("CFLAGS", "/I" + dlib_inc);   

        ADD_FLAG("LDFLAGS", "/libpath:\"" + dlib_lib + "\"");
        ADD_FLAG("LIBS", "dlib.lib");

    } else {
        WARNING("dlib.lib not found");
        PHP_DLIB = "no";
    }
}
