ARG_WITH("php_dlib", "for php-dlib support", "no");

if (PHP_PHP_DLIB != "no") {

    var dlib_dir = PHP_PHP_DLIB;

    if (dlib_dir == "no" || dlib_dir == "yes") {
        ERROR("Usage: --with-php-dlib=PATH_TO_DLIB");
    }

    EXTENSION("php_dlib",
        "php_dlib.cc " +
        "src/chinese_whispers.cc " +
        "src/face_detection.cc " +
        "src/face_landmark_detection.cc " +
        "src/face_recognition.cc " +
        "src/cnn_face_detection.cc " +
        "src/vector.cc"
    );

    // C++14 support
    ADD_FLAG("CXXFLAGS_PHP_DLIB", "/std:c++14");

    // Include paths
    ADD_INCLUDE(dlib_dir);
    ADD_INCLUDE(dlib_dir + "\\dlib");

    // Library path (IMPORTANT)
    ADD_LIBPATH(dlib_dir + "\\lib");

    // Link dlib static or import lib
    ADD_LIB("dlib");
}