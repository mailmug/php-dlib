// php_dlib config.w32

ARG_WITH("php-dlib", "for php-dlib support", "no");

if (PHP_PHP_DLIB != "no") {

    EXTENSION("php_dlib",
        "php_dlib.cc " +
        "src/chinese_whispers.cc " +
        "src/face_detection.cc " +
        "src/face_landmark_detection.cc " +
        "src/face_recognition.cc " +
        "src/cnn_face_detection.cc " +
        "src/vector.cc"
    );

    // Require C++ support
    ADD_SOURCES("php_dlib", "", "CXX");

    // Enable C++ standard
    ADD_FLAG("CXXFLAGS_PHP_DLIB", "/std:c++14");

    // Link C++ runtime
    ADD_LIB("stdc++", "php_dlib");

    // ---- dlib include/lib paths (Windows users must set manually) ----
    // Example:
    // --with-php-dlib=C:\dlib

    if (PHP_PHP_DLIB != "no") {

        var dlib_dir = PHP_PHP_DLIB;

        if (dlib_dir == "yes") {
            ERROR("Please specify dlib path: --with-php-dlib=DIR");
        }

        ADD_INCLUDE(dlib_dir);
        ADD_INCLUDE(dlib_dir + "\\dlib");

        ADD_LIBPATH(dlib_dir);

        // If dlib is built as static/lib
        ADD_FLAG("LIBS_PHP_DLIB", "dlib");

    }
}